FROM node:18-alpine

WORKDIR /app

# Copy backend-auth package files
COPY backend-auth/package*.json ./backend-auth/

# Install dependencies in backend-auth
RUN cd backend-auth && npm install

# Copy source code
COPY backend-auth/ ./backend-auth/
COPY .env ./

# Expose port
EXPOSE 8081

# Command to run the app
CMD ["node", "backend-auth/server.js"]
